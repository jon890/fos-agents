# 맥북이 읽는 값
#
# 실제 값은 워크스페이스 `.env` 에 넣는다. `.env` 는 추적하지 않는다.
# 맥북은 사진 저장소에 직접 붙지 않고 SSH 로 홈서버 명령을 부른다.
# 그래서 여기에는 S3 접속 정보를 두지 않는다.

# 홈서버 SSH 대상
JI_YOON_BLOG_SSH_TARGET=
# 포트와 키 파일 같은 SSH 추가 인자
JI_YOON_BLOG_SSH_ARGS=
# 홈서버의 저장소 경로. 생략하면 `~/fos-agents` 를 쓴다
JI_YOON_BLOG_REMOTE_ROOT=~/fos-agents
# 아이폰이 여는 Admin UI 주소의 앞부분
JI_YOON_BLOG_STORAGE_URL=


# 홈서버가 읽는 값
#
# 아래 값은 홈서버의 `~/apps/ji-yoon-blog/config/host.env` 에 있다.
# 그 파일은 mode 600 이며 홈서버 밖으로 내보내지 않는다.
# S3 API 는 홈서버 `127.0.0.1:8333` 에만 열려 있어서 맥북에서 닿지 않는다.
# 아래 목록은 그 파일이 어떤 항목을 갖는지 알리는 것이며 값은 여기에 넣지 않는다.
#
#   JI_YOON_BLOG_S3_ENDPOINT
#   JI_YOON_BLOG_S3_BUCKET
#   JI_YOON_BLOG_S3_ACCESS_KEY
#   JI_YOON_BLOG_S3_SECRET_KEY
#   JI_YOON_BLOG_PHOTO_PREFIX
