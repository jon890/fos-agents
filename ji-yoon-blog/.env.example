# 워크스페이스가 읽는 값의 목록이다.
#
# 실제 값은 워크스페이스 `.env` 에 넣는다. `.env` 는 추적하지 않는다.
# 사진 저장소로 가는 길은 두 갈래이고, 도는 자리가 어느 길인지 정한다.
# S3 설정을 읽을 수 있으면 그 자리에서 `scripts/photo_store.py` 를 부르고,
# 읽지 못하면 SSH 로 홈서버의 같은 스크립트를 부른다.
#
#   맥북             SSH 로 간다. 아래 `SSH` 항목을 채운다
#   홈서버           S3 로 간다. 저장소와 같은 상위 디렉터리에서 환경 파일을 찾는다
#   Hermes 컨테이너  S3 로 간다. HOME 이 달라도 같은 환경 파일을 찾는다


# 어느 자리에서나 읽는 값
#
# 아이폰이 여는 Admin UI 주소의 앞부분이다.
# bucket 경로까지 넣는다. 호스트만 넣으면 아이폰이 빈 화면을 본다.
# Admin UI 의 `path` 는 filer 경로이며 `/buckets/<bucket>` 에서 시작한다.
# bucket 이 빠진 주소도 Admin UI 가 200 으로 응답하고 빈 목록을 보여주므로
# 주소만 보고는 틀린 것을 알 수 없다.
#
# 이 값이 비면 폴더는 만들어지고 아이폰이 열 주소만 나오지 않는다.
# 홈서버와 Hermes 컨테이너에서도 `new` 를 쓰려면 이 값이 있어야 한다.
#
#   JI_YOON_BLOG_STORAGE_URL=https://<Admin UI 호스트>/buckets/ji-yoon-blog
JI_YOON_BLOG_STORAGE_URL=


# SSH 로 갈 때 읽는 값
#
# 맥북처럼 S3 에 닿지 않는 자리에서만 쓴다.
# 홈서버와 Hermes 컨테이너는 이 값을 읽지 않는다.

# 홈서버 SSH 대상
JI_YOON_BLOG_SSH_TARGET=
# 포트와 키 파일 같은 SSH 추가 인자
JI_YOON_BLOG_SSH_ARGS=
# 홈서버의 저장소 경로. 생략하면 `~/fos-agents` 를 쓴다
JI_YOON_BLOG_REMOTE_ROOT=~/fos-agents


# S3 로 갈 때 읽는 값
#
# 홈서버와 그 안의 Hermes 컨테이너에서 쓴다.
# 기본 환경 파일은 저장소와 같은 상위 디렉터리의
# `apps/ji-yoon-blog/config/host.env` 에서 찾는다.
# 다른 자리에 있으면 실행 환경에 아래 변수를 넣어 절대 경로를 지정한다.
#   JI_YOON_BLOG_HOST_ENV_PATH=<host.env 절대 경로>
# 워크스페이스 `.env` 가 있으면 먼저 읽는다.
# 환경 파일은 S3 값을 갖는다.
# 그 파일은 mode 600 이며 홈서버 밖으로 내보내지 않는다.
# S3 API 는 홈서버 `127.0.0.1:8333` 에만 열려 있어서 맥북에서 닿지 않는다.
# 아래 목록은 그 파일이 어떤 항목을 갖는지 알리는 것이며 값은 여기에 넣지 않는다.
#
#   JI_YOON_BLOG_S3_ENDPOINT
#   JI_YOON_BLOG_S3_BUCKET
#   JI_YOON_BLOG_S3_ACCESS_KEY
#   JI_YOON_BLOG_S3_SECRET_KEY
#   JI_YOON_BLOG_PHOTO_PREFIX
