{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/format-typescript.ts\"",
            "timeout": 30,
            "statusMessage": "TypeScript 포맷"
          }
        ]
      }
    ]
  }
}
