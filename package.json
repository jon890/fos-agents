{
  "name": "fos-agents",
  "version": "0.0.0",
  "private": true,
  "description": "fos-agents 모노레포 TypeScript 실행 환경",
  "type": "module",
  "scripts": {
    "format:position-recommender": "prettier --write 'career-os/scripts/position-recommender/**/*.{ts,html,css,js}' 'career-os/scripts/position-recommender/*.ts' career-os/scripts/lib/text.ts career-os/scripts/lib/text.test.ts career-os/scripts/lib/date-format.ts career-os/scripts/lib/date-format.test.ts",
    "format:position-recommender:check": "prettier --check 'career-os/scripts/position-recommender/**/*.{ts,html,css,js}' 'career-os/scripts/position-recommender/*.ts' career-os/scripts/lib/text.ts career-os/scripts/lib/text.test.ts career-os/scripts/lib/date-format.ts career-os/scripts/lib/date-format.test.ts",
    "format:position-render": "bun run format:position-recommender",
    "format:position-render:check": "bun run format:position-recommender:check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.9.6",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "zod": "^4.4.3"
  }
}
