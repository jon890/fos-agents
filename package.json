{
  "name": "fos-agents",
  "version": "0.0.0",
  "private": true,
  "description": "fos-agents 모노레포 TypeScript 실행 환경",
  "type": "module",
  "scripts": {
    "format:position-render": "prettier --write 'career-os/scripts/position-recommender/{render*,candidate_preview_html,recommendation_html,template}.ts' 'career-os/scripts/position-recommender/templates/*.{html,css,js}' career-os/scripts/lib/cli-contract.test.ts career-os/scripts/lib/date-format.ts career-os/scripts/lib/date-format.test.ts",
    "format:position-render:check": "prettier --check 'career-os/scripts/position-recommender/{render*,candidate_preview_html,recommendation_html,template}.ts' 'career-os/scripts/position-recommender/templates/*.{html,css,js}' career-os/scripts/lib/cli-contract.test.ts career-os/scripts/lib/date-format.ts career-os/scripts/lib/date-format.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.9.6",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "zod": "^4.4.3"
  }
}
