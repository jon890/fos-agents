{
  "schema": 2,
  "id": "fos-accountbook",
  "title": "가계부",
  "description": "토스 소비 화면 스크린샷을 가계부에 등록하고 수입과 지출을 조회하고 기록합니다.",
  "fields": [
    {
      "key": "token",
      "env": "ACCOUNTBOOK_API_TOKEN",
      "label": "연동 토큰",
      "description": "가계부 설정 화면에서 발급합니다.",
      "secret": true,
      "required": true,
      "pattern": "^fab_[A-Za-z0-9_-]{43}$"
    },
    {
      "key": "family",
      "env": "ACCOUNTBOOK_FAMILY_UUID",
      "label": "가족",
      "required": false,
      "options": {
        "tool": "list_families",
        "items": "families",
        "value": "uuid",
        "label": "name",
        "auto_select_single": true
      }
    }
  ],
  "verify": {
    "tool": "list_families"
  },
  "tools": {
    "list_families": {
      "risk": "READ",
      "approval": "none",
      "title": "가족 목록 조회"
    },
    "list_categories": {
      "risk": "READ",
      "approval": "none",
      "title": "카테고리 목록 조회"
    },
    "list_expenses": {
      "risk": "READ",
      "approval": "none",
      "title": "지출 목록 조회"
    },
    "list_incomes": {
      "risk": "READ",
      "approval": "none",
      "title": "수입 목록 조회"
    },
    "get_expense": {
      "risk": "READ",
      "approval": "none",
      "title": "지출 기록 조회"
    },
    "get_income": {
      "risk": "READ",
      "approval": "none",
      "title": "수입 기록 조회"
    },
    "create_expense": {
      "risk": "WRITE",
      "approval": "required",
      "title": "지출 등록"
    },
    "create_income": {
      "risk": "WRITE",
      "approval": "required",
      "title": "수입 등록"
    },
    "update_expense": {
      "risk": "WRITE",
      "approval": "required",
      "title": "지출 기록 수정"
    },
    "update_income": {
      "risk": "WRITE",
      "approval": "required",
      "title": "수입 기록 수정"
    },
    "delete_expense": {
      "risk": "WRITE",
      "approval": "required",
      "title": "지출 한 건 삭제: 날짜·금액·내용·카테고리 확인",
      "grant": false,
      "identifiers": ["date", "amount", "description", "categoryName", "recurringExpenseUuid"]
    },
    "delete_income": {
      "risk": "WRITE",
      "approval": "required",
      "title": "수입 한 건 삭제: 날짜·금액·내용·카테고리 확인",
      "grant": false,
      "identifiers": ["date", "amount", "description", "categoryName"]
    },
    "preview_screenshot_import": {
      "risk": "READ",
      "approval": "none",
      "title": "토스 화면 등록 미리보기"
    },
    "submit_screenshot_import": {
      "risk": "WRITE",
      "approval": "required",
      "title": "토스 화면 거래 등록"
    },
    "list_recurring_expenses": {
      "risk": "READ",
      "approval": "none",
      "title": "반복지출 목록 조회"
    },
    "update_recurring_expense": {
      "risk": "WRITE",
      "approval": "required",
      "title": "반복지출 설정 수정"
    }
  },
  "default_tool_policy": "deny",
  "toolsets": ["vision"],
  "attachments": true,
  "operator_env": ["ACCOUNTBOOK_API_BASE_URL"],
  "errors": {
    "ACCOUNTBOOK_DELETE_CONFIRMATION_MISMATCH": {
      "category": "invalid_input",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_UNAUTHORIZED": {
      "category": "credential_rejected",
      "recovery": "reconnect"
    },
    "ACCOUNTBOOK_FORBIDDEN": "forbidden",
    "ACCOUNTBOOK_OUTCOME_UNKNOWN": "outcome_unknown",
    "ACCOUNTBOOK_NETWORK": {
      "category": "unavailable",
      "recovery": "retry_later"
    },
    "ACCOUNTBOOK_UNAVAILABLE": {
      "category": "unavailable",
      "recovery": "retry_later"
    },
    "ACCOUNTBOOK_INVALID_RESPONSE": "unavailable",
    "ACCOUNTBOOK_CONFIG": {
      "category": "unavailable",
      "recovery": "reconnect"
    },
    "ACCOUNTBOOK_NO_FAMILY": {
      "category": "forbidden",
      "recovery": "reconnect"
    },
    "ACCOUNTBOOK_INVALID_INPUT": {
      "category": "invalid_input",
      "recovery": "fix_input"
    },
    "ACCOUNTBOOK_BAD_REQUEST": {
      "category": "invalid_input",
      "recovery": "fix_input"
    },
    "ACCOUNTBOOK_CATEGORY_SELECTION": {
      "category": "invalid_input",
      "recovery": "fix_input"
    },
    "ACCOUNTBOOK_FAMILY_SELECTION": {
      "category": "invalid_input",
      "recovery": "fix_input"
    },
    "ACCOUNTBOOK_NOT_FOUND": {
      "category": "invalid_input",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_IMPORT_CONFIRMATION_MISMATCH": {
      "category": "invalid_input",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_IMPORT_NOT_SUBMITTABLE": {
      "category": "invalid_input",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_IMPORT_PARTIAL": {
      "category": "unavailable",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_IMPORT_IN_PROGRESS": {
      "category": "unavailable",
      "recovery": "recheck"
    },
    "ACCOUNTBOOK_OUTPUT_UNAVAILABLE": "unavailable",
    "ACCOUNTBOOK_OUTPUT_LIMIT": {
      "category": "invalid_input",
      "recovery": "fix_input"
    }
  },
  "owner_output_env": "ACCOUNTBOOK_OUTPUT_DIR"
}
