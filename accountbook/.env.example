# accountbook API의 /api/v1까지 포함한 공인 HTTPS 주소
ACCOUNTBOOK_API_BASE_URL=

# 등록할 가족 UUID (MCP는 비우면 가족 목록에서 선택)
ACCOUNTBOOK_FAMILY_UUID=

# 가계부 설정에서 발급한 사용자별 연동 토큰
ACCOUNTBOOK_API_TOKEN=

# 이미지 스킬의 사용자별 비공개 루트 (비우면 accountbook/private)
# 공용 마운트에서는 profile마다 서로 다른 경로를 지정한다.
ACCOUNTBOOK_PRIVATE_DIR=

# 후보에 categoryName이 없을 때 사용할 카테고리
ACCOUNTBOOK_DEFAULT_CATEGORY_NAME=미분류

# OCR 지출을 기본적으로 예산에서 제외할지 결정한다.
ACCOUNTBOOK_EXCLUDE_FROM_BUDGET=false
