{
  "mcpServers": {
    "career": {
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/career-mcp.js"],
      "env": {
        "CAREER_BACKEND_URL": "${CAREER_BACKEND_URL}",
        "CAREER_BACKEND_TOKEN": "${CAREER_BACKEND_TOKEN}",
        "CAREER_GITHUB_TOKEN": "${CAREER_GITHUB_TOKEN:-}",
        "CAREER_GITHUB_PROFILE_REPO": "${CAREER_GITHUB_PROFILE_REPO}",
        "CAREER_BACKEND_ACCESS_CLIENT_ID": "${CAREER_BACKEND_ACCESS_CLIENT_ID:-}",
        "CAREER_BACKEND_ACCESS_CLIENT_SECRET": "${CAREER_BACKEND_ACCESS_CLIENT_SECRET:-}"
      }
    }
  }
}
