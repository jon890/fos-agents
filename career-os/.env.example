# 커리어 작업 폴더. 실행 공간에서는 비서가 넘기고, 노트북에서 실행기를 직접 돌릴 때만 채운다
CAREER_WORKSPACE_ROOT=
# 프로젝트 근거 저장소(Git 저장소의 루트이거나 그 바로 아래)
CAREER_EVIDENCE_DIR=
# 사용량 파일의 자리(CAREER_AGENT_USAGE_FILE)는 여기 두지 않는다. 수집기는 .env 를 읽지 않으므로 셸 환경 변수로만 준다

# 커리어 Backend client. 포지션 추천, 공부 추천, 회사 근거가 함께 쓴다
CAREER_BACKEND_URL=
CAREER_BACKEND_TOKEN=
CAREER_BACKEND_TOKEN_FILE=
# Backend 가 Cloudflare Access 뒤에 있을 때만 채운다. ID 와 secret 은 함께 채우고, secret 은 파일(mode 600)로 줄 수도 있다
CAREER_BACKEND_ACCESS_CLIENT_ID=
CAREER_BACKEND_ACCESS_CLIENT_SECRET=
CAREER_BACKEND_ACCESS_CLIENT_SECRET_FILE=

# 면접 연습 기록은 커리어 작업 폴더(CAREER_WORKSPACE_ROOT)의 state/career.sqlite 에 쌓인다.
# CAREER_MEMORY: file 은 CAREER_MEMORY_FILE 을 읽고, context 는 작업 폴더의 context/career-status.md 와 context/application-state.md 를 읽는다.
CAREER_MEMORY=file
CAREER_MEMORY_FILE=

# 커리어 Backend 서버: 개발은 URL, 운영은 DB_* 묶음 중 하나만 사용한다.
CAREER_BACKEND_DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
API_HOST=
API_PORT=
CAREER_BACKEND_MAX_BODY_BYTES=
