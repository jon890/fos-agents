# career-os private workspace sync helper
CAREER_WORKSPACE_ROOT=
CAREER_WORKSPACE_PRODUCER_SKILL=
CAREER_WORKSPACE_PRODUCER_MODE=
# 홈서버 Hermes는 command transport를 최우선으로 사용한다.
CAREER_WORKSPACE_COMMAND=
# 외부 client는 command가 없을 때 SSH transport를 사용한다.
CAREER_WORKSPACE_SSH_TARGET=
CAREER_WORKSPACE_SSH_ARGS=
CAREER_WORKSPACE_REMOTE_COMMAND=
CAREER_WORKSPACE_ENV_FILE=
PROJECTS_ROOT=
PERSONAL_ROOT=

# 커리어 Backend client. 포지션 추천, 공부 추천, 회사 근거가 함께 쓴다
CAREER_BACKEND_URL=
CAREER_BACKEND_TOKEN=
CAREER_BACKEND_TOKEN_FILE=
# Backend 가 Cloudflare Access 뒤에 있을 때만 채운다. ID 와 secret 은 함께 채우고, secret 은 파일(mode 600)로 줄 수도 있다
CAREER_BACKEND_ACCESS_CLIENT_ID=
CAREER_BACKEND_ACCESS_CLIENT_SECRET=
CAREER_BACKEND_ACCESS_CLIENT_SECRET_FILE=

# 면접 연습 기록 저장소와 후보자 맥락 공급자
CAREER_STORE=file
CAREER_STORE_DIR=
# CAREER_MEMORY: file 은 CAREER_MEMORY_FILE 을 읽고, backend 는 커리어 Backend 의 후보자 맥락 문서를 읽는다.
CAREER_MEMORY=file
CAREER_MEMORY_FILE=

# 지원서 공통 프로필. fos-assistant Memory 의 identity 문서를 서비스 토큰으로 읽는다
FOS_ASSISTANT_URL=
FOS_ASSISTANT_SERVICE_TOKEN=
# fos-assistant 가 Cloudflare Access 뒤에 있을 때만 채운다
FOS_ASSISTANT_ACCESS_CLIENT_ID=
FOS_ASSISTANT_ACCESS_CLIENT_SECRET=
FOS_ASSISTANT_ACCESS_CLIENT_SECRET_FILE=

# 커리어 Backend 서버: 개발은 URL, 운영은 DB_* 묶음 중 하나만 사용한다.
CAREER_BACKEND_DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
API_HOST=
API_PORT=
CAREER_BACKEND_MAX_BODY_BYTES=

# 홈서버 career-storage wrapper와 S3 실행 파일
CAREER_STORAGE_S3_EXECUTABLE=
CAREER_STORAGE_LOCK_FILE=
CAREER_STORAGE_S3_ENDPOINT=
CAREER_STORAGE_S3_BUCKET=career-os
CAREER_STORAGE_S3_ACCESS_KEY=
CAREER_STORAGE_S3_SECRET_KEY=
CAREER_STORAGE_MAX_ARCHIVE_BYTES=
