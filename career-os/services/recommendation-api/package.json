    "prisma:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.2.1",
    "mariadb": "3.4.5",
    "typescript": "^5.5.0",
    "vitest": "5.0.1"
  }
}
