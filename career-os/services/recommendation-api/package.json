{
  "name": "@career-os/recommendation-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
